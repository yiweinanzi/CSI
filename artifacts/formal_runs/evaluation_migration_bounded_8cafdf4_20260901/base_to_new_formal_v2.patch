+        or results["termination_reason"] != POST_EXIT_TERMINATION_REASON
+        or results["pid_relation"] != POST_EXIT_PID_RELATION
+        or results["monitor_window_valid"] is not True
+        or results["lock_state"] != POST_EXIT_LOCK_STATUS
