+        if not _is_within(artifact, evaluation_root) or artifact in expected_paths:
+            raise RuntimeError("legacy inventory artifact escapes or is duplicated")
+        expected_binding = {
+            "path": str(artifact),
+            "bytes": row["bytes"],
+            "sha256": row["sha256"],
+        }
