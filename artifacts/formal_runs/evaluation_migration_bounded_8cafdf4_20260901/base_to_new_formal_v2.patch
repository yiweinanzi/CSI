+def _authenticate_migration_evidence(
+    paths: Mapping[str, str | Path],
+    *,
+    legacy_run_root: Path,
+    new_run_root: Path,
+    legacy_source: dict[str, object],
+    new_source: dict[str, object],
+    dataset_sha256: str,
+    config_sha256: str,
+    protocol_sha256: str,
+    new_run_id: str,
+    new_run_nonce: str,
+    new_compute_plan_sha256: str,
