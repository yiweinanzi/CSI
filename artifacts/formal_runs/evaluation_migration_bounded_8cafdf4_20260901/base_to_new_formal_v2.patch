+            side_effect=_per_position_state_oracle,
+        )
+        if legacy
+        else nullcontext()
+    )
+    with replacement:
+        return _response_probe_dataset(
+            model,
+            dataset,
+            teacher,
+            {},
+            normalization,
+            np.asarray([0]),
+            active_only=active_only,
+            route_normalization=object(),
+            routed=routed,
+            batch_size=batch_size,
+        )
