+
+def run_same_source_decomposition_comparison(
+    *,
+    config_path: str | Path,
+    dataset_path: str | Path,
+    legacy_run_root: str | Path,
+    report_path: str | Path,
+    device: str = "cuda:0",
+    batch_size: int = 1,
+    source_scenes: int = 1,
+    target_scenes_per_city: int = 1,
