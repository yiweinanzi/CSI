+def _scene_selection_key(dataset, scene: int) -> tuple[str, str, str, str, int]:
+    index = int(scene)
+    return (
+        str(dataset.city_ids[index]),
+        str(dataset.bank_ids[index]),
+        str(legacy._canonical_bank_digest(dataset, index)),
+        str(dataset.scene_ids[index]),
+        index,
+    )
