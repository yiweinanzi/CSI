+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=True,
+            allow_nan=False,
+        ).encode("utf-8")
+        return {
+            "artifact_label": "csi-pairs-v6-test-fixture",
+            "dataset_sha256": "b" * 64,
+            "config_sha256": "c" * 64,
+            "fixture": True,
+            "scientific_use": "FORBIDDEN",
+            "source_tree_sha256": source_tree,
