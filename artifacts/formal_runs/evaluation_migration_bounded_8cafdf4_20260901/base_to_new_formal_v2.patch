+            state["route_normalization"] = route_normalization
+            state["normalization"] = normalization
+
+        def ensure_checkpoint_model(
+            unit: EvaluationWorkUnit,
+            checkpoint: Mapping[str, object],
+            state: dict[str, object],
+        ) -> None:
