+            "seed": 20270001,
+            "source_tree_sha256": self.source_sha256,
+            "requirements_lock_sha256": self.requirements_sha256,
+            "runtime_provenance_sha256": self.runtime_sha256,
+            "teacher_checkpoint_sha256": _digest("teacher"),
