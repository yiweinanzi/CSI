+        fragment = read_strict_json(fragment_path)
+        if not isinstance(fragment, dict):
+            raise RuntimeError("subset worker fragment is not a JSON object")
+        artifacts[role] = {
+            "request_path": request_path,
+            "fragment_path": fragment_path,
+            "fragment": fragment,
